# Copy this file to .env and fill in what you use: `npm run portraits:paint` reads it (spec 011).
# .env is ignored by git, so your keys stay on your computer. Leave a line empty when you don't use that service.
# Note: Vite only exposes variables starting with VITE_ to the app, so these never reach the website.

# AI Horde (https://aihorde.net/register): optional, gives your requests a higher priority than anonymous ones.
AI_HORDE_API_KEY=

# Cloudflare Workers AI (only for --service cloudflare).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
